# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use: gemini (default) or openai_compat
LLM_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is busy or out of free quota (free-tier quotas are per model)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# Policy source: either a path to policy.json ...
POLICY_PATH=data/policy.json
# ... or the full policy JSON as a single string (takes precedence if set)
# POLICY_JSON={"meta": {...}, "sections": [...]}

# Optional OpenAI-compatible fallback (used if Gemini is busy)
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_API_KEY=your-key
# OPENAI_COMPAT_MODEL=model-name
