# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud "Secrets" box.
# Never commit secrets.toml. Set at least one API key.

LLM_PROVIDER = "openai_compat"

# DeepSeek (primary)
OPENAI_COMPAT_API_KEY = "your-deepseek-api-key"
OPENAI_COMPAT_BASE_URL = "https://api.deepseek.com"
OPENAI_COMPAT_MODEL = "deepseek-flash"

# Gemini (fallback)
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_THINKING_LEVEL = "medium"

# The full policy as a JSON string, so the policy never has to be in the public repo.
POLICY_JSON = '''
{"meta": {"title": "..."}, "sections": [{"id": "1", "parent": "", "heading": "...", "path": "...", "text": "..."}]}
'''
