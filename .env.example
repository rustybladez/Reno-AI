# Copy to .env and fill in. Never commit .env.
# Set at least one API key. With both, the primary (LLM_PROVIDER) answers and the other
# takes over when it is busy.

# Primary provider: openai_compat (DeepSeek, default) or gemini
LLM_PROVIDER=openai_compat

# DeepSeek (OpenAI-compatible API, https://api-docs.deepseek.com). Paid, no rate quotas.
OPENAI_COMPAT_API_KEY=your-deepseek-api-key
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_MODEL=deepseek-flash
# Optional: enabled | disabled (unset = DeepSeek default, thinking on), and low | high | max
# OPENAI_COMPAT_THINKING=enabled
# OPENAI_COMPAT_REASONING_EFFORT=high

# Gemini (free key at https://aistudio.google.com/apikey). Free tier has small per-model quotas.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=medium
# Optional extra Gemini models to try when the main one is busy (comma-separated). Only add
# models you have run the evals on.
# GEMINI_FALLBACK_MODELS=

# Policy source: either a path to policy.json ...
POLICY_PATH=data/policy.json
# ... or the full policy JSON as a single string (takes precedence if set)
# POLICY_JSON={"meta": {...}, "sections": [...]}
