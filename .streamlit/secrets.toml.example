# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud "Secrets" box.
# Never commit secrets.toml.

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS = "gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash"
GEMINI_THINKING_LEVEL = "low"

# The full policy as a JSON string, so the policy never has to be in the public repo.
POLICY_JSON = '''
{"meta": {"title": "..."}, "sections": [{"id": "1", "parent": "", "heading": "...", "path": "...", "text": "..."}]}
'''

# Optional OpenAI-compatible fallback
# OPENAI_COMPAT_BASE_URL = "https://api.example.com/v1"
# OPENAI_COMPAT_API_KEY = "your-key"
# OPENAI_COMPAT_MODEL = "model-name"
